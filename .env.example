DATABASE_URL=postgresql+psycopg://engine:engine@localhost:5432/engine
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=youtube-engine

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=engine
S3_ACCESS_KEY=engine
S3_SECRET_KEY=engine-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_FERNET_KEY=

CHANNEL_ID=local

YT_AUDIT_APPROVED=false
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:8000/youtube/oauth/callback

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=stock-calm-en-us
TTS_BACKUP_API_KEY=

YOUTUBE_API_KEY=
YOUTUBE_REFRESH_TOKEN=

ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# dev | staging | production — production blocks simulated providers and requires API_KEY + Temporal
ENGINE_MODE=dev
RUN_MIGRATIONS=false

# Platform / operations
LOG_LEVEL=INFO
LOG_FORMAT=text
OTEL_ENABLED=false
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=youtube-engine-api
SHUTDOWN_TIMEOUT_S=30
READINESS_TIMEOUT_S=2
REDIS_CONNECT_TIMEOUT_S=1
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_AFTER_S=30

YOUTUBE_POLICY_WEBHOOK_SECRET=

# Optional. When set, every route except /health, /ready, /live, /metrics requires X-API-Key.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENGINE_VERSION=2027.1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
WORKER_THREADS=16
