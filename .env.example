DATABASE_URL=postgresql+psycopg://engine:engine@localhost:5432/engine
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=dual-engine

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=engine
S3_ACCESS_KEY=engine
S3_SECRET_KEY=engine-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_FERNET_KEY=

YT_AUDIT_APPROVED=false
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:8000/youtube/oauth/callback

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=stock-calm-en-us
TTS_BACKUP_API_KEY=

YOUTUBE_API_KEY=
YOUTUBE_REFRESH_TOKEN=

EMAIL_PROVIDER=direct
INSTANTLY_API_KEY=
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
CALENDAR_PROVIDER=calcom
CALCOM_API_KEY=
CRM_WEBHOOK_URL=

# Closing: payment links (auto picks Razorpay in india, else Stripe) and e-signature
PAYMENT_PROVIDER=auto
PAYMENT_CURRENCY=inr
PAYMENT_SUCCESS_URL=https://example.com/thanks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# memory | documenso
ESIGN_PROVIDER=memory
DOCUMENSO_API_KEY=
DOCUMENSO_BASE_URL=https://app.documenso.com/api/v1
DOCUMENSO_TEMPLATE_ID=
ESIGN_WEBHOOK_SECRET=

# Consent-gated channels (only used after the lead opts in)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ACQUISITION_TENANT_ID=local
ACQUISITION_REGION=india
ACQUISITION_WEEKLY_QUALIFIED_TARGET=5
ACQUISITION_ESCALATION_SLA_HOURS=24

# dev | staging | production — production blocks simulated providers and requires API_KEY + Temporal
ENGINE_MODE=dev
RUN_MIGRATIONS=false

# Shared secret for dev webhook endpoints (required in production per provider)
WEBHOOK_SHARED_SECRET=
INBOUND_EMAIL_WEBHOOK_SECRET=
EMAIL_EVENTS_WEBHOOK_SECRET=
CALCOM_WEBHOOK_SECRET=
VAPI_WEBHOOK_SECRET=
YOUTUBE_POLICY_WEBHOOK_SECRET=

# Optional. When set, every route except /health, /ready, /live, /metrics and /webhooks requires X-API-Key.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENGINE_VERSION=2027.1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
WORKER_THREADS=16
